{
  "name": "first-x-and-xi",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tinacms dev -c \"tsx scripts/render.ts && vite --host 0.0.0.0\"",
    "build": "tinacms build && tsx scripts/render.ts && vite build",
    "build:local": "tinacms build --local --skip-cloud-checks -c \"tsx scripts/render.ts && vite build\"",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@tinacms/cli": "^1.12.0",
    "tinacms": "^2.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "vite": "^6.4.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": "22.x"
  }
}